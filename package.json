{
    "name": "obsidian-custom-views",
    "version": "0.5.4",
    "description": "Create custom HTML views for your notes based on filter rules. Transform how your notes are displayed.",
    "main": "main.js",
    "scripts": {
        "dev": "node esbuild.config.mjs",
        "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
        "version": "node version-bump.mjs && git add manifest.json versions.json",
        "lint": "eslint . --max-warnings 0 && stylelint styles.css --max-warnings 0",
        "lint:fix": "eslint . --fix",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "typecheck": "tsc -p tsconfig.browser.json",
        "sync:local": "node scripts/sync-local.mjs",
        "check:obsidian": "node scripts/obsidian-compat/check-internals.mjs",
        "test:compat": "node --test scripts/obsidian-compat/internals.test.mjs",
        "test:local-deploy": "node --test scripts/sync-local.test.mjs"
    },
    "keywords": [],
    "author": "Anup Chavan",
    "license": "MIT",
    "devDependencies": {
        "@codemirror/autocomplete": "^6.0.0",
        "@codemirror/commands": "^6.0.0",
        "@codemirror/lang-css": "^6.3.1",
        "@codemirror/lang-html": "^6.4.12",
        "@codemirror/lang-javascript": "^6.2.5",
        "@codemirror/language": "^6.0.0",
        "@codemirror/lint": "^6.0.0",
        "@codemirror/search": "^6.0.0",
        "@codemirror/state": "^6.0.0",
        "@codemirror/view": "^6.0.0",
        "@lezer/common": "^1.0.3",
        "@lezer/css": "^1.3.3",
        "@lezer/highlight": "^1.2.3",
        "@lezer/html": "^1.3.13",
        "@lezer/javascript": "^1.5.4",
        "@types/node": "^22.19.0",
        "@typescript-eslint/eslint-plugin": "^8.74.0",
        "@typescript-eslint/parser": "^8.74.0",
        "@typescript-eslint/utils": "^8.74.0",
        "@vitest/coverage-v8": "^5.1.1",
        "esbuild": "^0.28.2",
        "eslint": "^10.15.0",
        "eslint-plugin-obsidianmd": "^0.6.0",
        "jsdom": "^31.0.1",
        "moment": "^2.31.0",
        "obsidian": "latest",
        "stylelint": "^18.1.0",
        "stylelint-no-unsupported-browser-features": "^8.1.2",
        "tslib": "^2.8.1",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.74.0",
        "vitest": "^5.1.1"
    },
    "dependencies": {
        "knap": "^0.4.2",
        "nanoid": "^6.0.2"
    },
    "overrides": {
        "@codemirror/state": "$@codemirror/state",
        "@codemirror/view": "$@codemirror/view",
        "eslint-plugin-obsidianmd": {
            "obsidian": "$obsidian"
        }
    }
}
