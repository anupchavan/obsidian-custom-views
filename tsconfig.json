{
    "compilerOptions": {
        "baseUrl": ".",
        "inlineSourceMap": true,
        "inlineSources": true,
        "module": "ESNext",
        "target": "ES6",
        "allowJs": true,
        "noImplicitAny": true,
        "moduleResolution": "node",
        "importHelpers": true,
        "allowSyntheticDefaultImports": true,
        "isolatedModules": true,
        "strictNullChecks": true,
        "lib": [
            "DOM",
            "DOM.Iterable",
            "ES2022"
        ],
        "strictBindCallApply": true,
        "strictBuiltinIteratorReturn": true
    },
    "include": [
        "**/*.ts"
    ]
}
